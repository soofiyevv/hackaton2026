# Copy to .env and fill in. Never commit .env.
GEMINI_API_KEY=
GROQ_API_KEY=

# auto = real LLM, falls back to offline simulation if all models fail (labelled in UI)
# live = real LLM only | offline = deterministic simulation, no API calls
UNIRESOLVE_MODE=auto

# Ordered fallback chains "provider:model,...". Each Groq model has its own rate limit.
# Heavy agents (Resolution, Auditor):
LLM_CHAIN=groq:openai/gpt-oss-120b,groq:openai/gpt-oss-20b,gemini:gemini-3.5-flash,gemini:gemini-3.8-flash
# Light agents (Triage, Routing):
LLM_CHAIN_FAST=groq:openai/gpt-oss-20b,gemini:gemini-3.5-flash-lite,groq:openai/gpt-oss-120b,gemini:gemini-3.5-flash
GROQ_REASONING_EFFORT=low

LLM_TIMEOUT_S=15
MAX_REVISIONS=2
# UNIRESOLVE_DB=data/uniresolve.db
